{
  "name": "musicdownloader",
  "version": "0.1.0",
  "description": "A desktop playlist matcher and public-source music downloader.",
  "private": true,
  "main": "dist/main/main.js",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "cross-env MUSICDOWNLOADER_DEV=1 concurrently -k \"vite\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on tcp:5173 dist/main/main.js && electron .\"",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "check": "npm run lint && npm run test && npm run build",
    "start": "electron .",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "42.3.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.12.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.8",
    "wait-on": "^8.0.1"
  }
}
